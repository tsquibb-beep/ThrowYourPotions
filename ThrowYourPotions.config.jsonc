// Throw Your Potions — settings. Restart the game after editing.
//
// The defaults are the whole point of the mod. Everything here exists only so you can tone it
// down if you must. Copy this file to your save folder to keep your settings through updates:
//   %APPDATA%\SlayTheSpire2\ThrowYourPotions.config.jsonc
// That copy is read in preference to this one.
{
    // Master switch.
    "enabled": true,

    // The big text. Set showText to false for noise only.
    "showText": true,
    "text": "THROW YOUR POTIONS",

    // How the letters look and move, using the game's own text effects.
    //   textStyle:  "rainbow" (every letter a different colour), "gold",
    //               "slime" (Foul Potion green), or "plain" (one flat colour)
    //   textMotion: "jitter" (shakes), "sine" (bobs), or "none"
    "textStyle": "gold",
    "textMotion": "jitter",

    // The words land one at a time, stacked down the screen and sitting crooked.
    // wordStepSeconds is the beat between them; wordTiltDegrees is how skewed
    // they sit, alternating side to side.
    "wordStepSeconds": 0.2,
    "wordTiltDegrees": 6,

    // Full-screen colour wash as the text lands. Fades out by itself.
    "flash": true,
    "flashColor": "#4fd14f",
    "fontSize": 140,
    "textColor": "#fff1c9",
    "outlineColor": "#1a0f06",
    "outlineSize": 24,

    // How long the text sits there before fading out, in seconds.
    "holdSeconds": 2.4,

    // Rumble the screen for as long as the text is up, like the merchant room
    // does when you actually throw a potion at him.
    "screenShake": true,

    // Slime splats going off around the text while it is up - the Foul Potion's
    // own splat, so it shows you what you are being told to do. They land on a
    // ring around the words rather than over them, at random sizes.
    "splats": true,
    "splatCount": 14,
    "splatScaleMin": 1.4,
    "splatScaleMax": 3.2,

    // rAnDoM cAsE, re-rolled every time so it never looks the same twice.
    "wackyCase": true,

    // The racket. The sound engine will not play one of his voice lines on top of
    // itself, so the noises come in waves: every noise he has at once (a fraction
    // of a second apart), then the whole lot again once they have finished.
    // soundCount is the total number played; soundGapSeconds spaces them within a
    // wave; soundWaveSeconds is how long until the same noise can be used again.
    "soundCount": 20,
    "soundGapSeconds": 0.08,
    "soundWaveSeconds": 1.3,
    "soundVolume": 1.0,

    // "mix" cycles everything he has: the thank you, the welcome, the idle
    // mumble and the disappointed grunt. At the Fake Merchant, both add his laugh.
    // "buy" repeats only his purchase noise — but the sound engine refuses to
    // play a voice line over itself, so "buy" ends up almost silent. Mix is the
    // default for that reason.
    "soundSet": "buy",

    // How long to wait after arriving before going off. Room entry happens behind
    // a fade to black, so firing immediately would play under it.
    "delaySeconds": 0.6
}
